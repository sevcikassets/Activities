# Copy this file to .env and fill in real values. .env is only read locally
# by Docker Compose - never commit it.

# Login for the first admin account. It is created automatically on first
# startup when the users table is empty. Later users and passwords are managed
# in the Uzivatele section.
APP_USERNAME=admin
APP_PASSWORD=change-me-before-first-run

# Random session-signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it stable across restarts, or everyone gets logged out each deploy.
APP_TOKEN_SECRET=change-me-to-a-long-random-secret

# PostgreSQL used by Docker deployment.
POSTGRES_DB=activities
POSTGRES_USER=activities
POSTGRES_PASSWORD=change-me-before-first-run
DATABASE_URL=postgresql+psycopg://activities:change-me-before-first-run@db:5432/activities

# Local development defaults:
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production domain routed by the shared Traefik proxy.
# DNS must point at the AWS server before enabling HTTPS.
DOMAIN=activities.sevcikassets.cz
# API_CORS_ORIGINS=https://activities.sevcikassets.cz
# NEXT_PUBLIC_API_URL=https://activities.sevcikassets.cz/api
